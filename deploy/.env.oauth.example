# Copy to a private .env.oauth (chmod 600). Do not load Basic credentials here.
# This feature is unreleased: choose a verified OAuth-capable image/digest.
FOUNDRY_MCP_IMAGE=
FOUNDRY_MCP_LAN_ADDRESS=192.0.2.10
FOUNDRY_MCP_PUBLIC_URL=https://mcp.example.com
FOUNDRY_MCP_OAUTH_ISSUER=https://YOUR_TENANT.REGION.auth0.com/
FOUNDRY_MCP_OAUTH_ALLOWED_SUBJECTS=auth0|REPLACE_WITH_YOUR_USER_ID
FOUNDRY_MCP_OAUTH_ALLOWED_CLIENT_IDS=REPLACE_WITH_CHATGPT_AUTH0_CLIENT_ID
FOUNDRY_MCP_BRIDGE_TOKEN=
FOUNDRY_MCP_PDF_ENABLED=false
FOUNDRY_MCP_PDF_TRUSTED_GM_MCP=false
FOUNDRY_MCP_PDF_UPLOAD_ENABLED=false
FOUNDRY_MCP_PDF_UPLOAD_TOKEN=
# Enable only with enforced HTTPS/WSS termination and proxy-only backend access.
FOUNDRY_MCP_PDF_TRUST_TLS_PROXY=false
