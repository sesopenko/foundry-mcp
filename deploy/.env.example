# Copy to a private .env file. Set the LAN address and credentials before deployment.
# Pin a release tag, full commit tag, or digest; never use latest.
FOUNDRY_MCP_IMAGE=sesopenko/foundry-mcp:v2.4.0
FOUNDRY_MCP_LAN_ADDRESS=192.0.2.10

# Set nonempty credentials of your choosing; no password policy is enforced.
# Leave these empty until configured; startup must fail with missing credentials.
FOUNDRY_MCP_BASIC_USERNAME=librechat
FOUNDRY_MCP_BASIC_PASSWORD=
FOUNDRY_MCP_BRIDGE_TOKEN=

# Optional GM-private reference library. Never share this endpoint's MCP credentials with players.
FOUNDRY_MCP_PDF_ENABLED=false
FOUNDRY_MCP_PDF_TRUSTED_GM_MCP=false
FOUNDRY_MCP_PDF_UPLOAD_ENABLED=false
FOUNDRY_MCP_PDF_UPLOAD_TOKEN=
# Only true behind an operator-enforced HTTPS/WSS proxy with private upstream access.
FOUNDRY_MCP_PDF_TRUST_TLS_PROXY=false
FOUNDRY_MCP_PDF_MAX_UPLOAD_BYTES=134217728
FOUNDRY_MCP_PDF_QUOTA_BYTES=2147483648
