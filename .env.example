# Copy this file to `.env` and fill in your own values.
#
# IMPORTANT: `.env` is gitignored so secrets don't get committed.

# Required Foundry credentials
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
FOUNDRY_ADMIN_KEY=
FOUNDRY_LICENSE_KEY=

# Optional configuration overrides
FOUNDRY_HOSTNAME=my_foundry_host
FOUNDRY_VERSION=13.351
FOUNDRY_PROXY_PORT=443
FOUNDRY_PROXY_SSL=true
FOUNDRY_MINIFY_STATIC_FILES=true
FOUNDRY_PRESERVE_CONFIG=true
